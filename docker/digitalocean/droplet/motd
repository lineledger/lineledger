#!/bin/sh
# Login banner for a LineLedger Droplet (/etc/update-motd.d/99-lineledger).

url=$(grep -E '^APP_URL=' /opt/lineledger/.env 2> /dev/null | tail -n 1 | cut -d= -f2-)

cat << EOF

  LineLedger is running at ${url:-(still starting; check with: lineledger status)}

  First visit: register. The first account becomes the site admin.
  Then open Admin -> Email to set up outgoing mail.

  Use your own domain, with HTTPS:   lineledger domain books.example.com
  Upgrade to the newest release:     lineledger upgrade
  Everything else:                   lineledger help

EOF

case "$url" in
    http://*) printf '  Until you add a domain, traffic to LineLedger is not encrypted.\n\n' ;;
esac
