# LineLedger self-hosted Docker environment.
# Copy to .env next to docker-compose.yml and fill in the required values.
# The root .env.example in the repo documents the full env surface; this file
# is the minimum for a self-hosted single-server install.

APP_NAME=LineLedger
APP_ENV=production
APP_DEBUG=false

# REQUIRED. Generate with:
#   docker compose run --rm --no-deps app php artisan key:generate --show
# Back this value up — it encrypts sessions and secrets, and losing it makes
# that data unrecoverable.
APP_KEY=

# Must match how users reach the app (scheme included — HTTPS here turns on
# Secure cookies via APP_ENV=production, and it drives passkey and logo URLs).
APP_URL=http://localhost:8080

# Country this deployment serves (CA / US). Set it explicitly when
# self-hosting: the automatic fallback derives it from the request host and
# targets the upstream lineledger.ca/.com domains.
APP_REGION=CA

# Secret used to derive passkey (WebAuthn) user handles. Set a stable random
# string NOW: when unset it falls back to APP_KEY, so a later APP_KEY rotation
# would silently invalidate every registered passkey. Never rotate it.
PASSKEYS_USER_HANDLE_SECRET=

# Ops alerting — security:monitor, integrity:check and rates:health email the
# first two on failure; OPS_ALERT_EMAIL gets the hourly failed-jobs digest and any
# scheduled task that crashes. The defaults point at the upstream project's inbox,
# so set your own.
SECURITY_ALERT_EMAIL=you@example.com
LEDGER_INTEGRITY_ALERT_EMAIL=you@example.com
OPS_ALERT_EMAIL=you@example.com

# --- Database (the mysql service in docker-compose.yml) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=lineledger
DB_USERNAME=lineledger
# Both passwords are required; the mysql container creates the database and
# user on first boot, and the healthcheck uses the root password.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Database-backed drivers need no extra services and provide the shared locks
# the scheduler relies on. Switch to redis with the compose redis profile.
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Mail (required for invites, reminders, backups, alerts) ---
# For a local test run: start mailpit (docker compose --profile mail up -d)
# and set MAIL_HOST=mailpit, MAIL_PORT=1025 — the UI is at localhost:8025.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=books@example.com
MAIL_FROM_NAME="${APP_NAME}"

# --- Compose knobs ---
# Pin to a release tag (e.g. 1.1.0) instead of latest for controlled upgrades.
# LINELEDGER_VERSION=latest
# Host port the app is published on when running behind a reverse proxy / LAN.
# HTTP_PORT=8080
# For direct exposure with automatic HTTPS: set your domain here and uncomment
# the 80/443 ports on the app service in docker-compose.yml.
# SERVER_NAME=books.example.com
# Run migrations and post-upgrade steps (php artisan app:upgrade) every time
# the app container starts. Set to false to run upgrades by hand: the
# container then boots on the existing schema and you run
#   docker compose exec app php artisan app:upgrade
# when ready (after taking a backup, for instance).
# MIGRATE_ON_BOOT=true
#
# Backups: backup.sh / restore.sh next to this file take and load a full
# on-demand backup (database dump + storage volume + .env). For scheduled
# database dumps enable the backup profile:
#   docker compose --profile backup up -d
# It writes lineledger-db-<ts>.sql.gz into BACKUP_DIR (a host directory, so
# `docker compose down -v` never deletes it) every BACKUP_INTERVAL_SECONDS and
# prunes dumps older than BACKUP_KEEP_DAYS. Database only: attachments and
# uploads are in the storage volume, which backup.sh archives.
#
# BACKUP_DIR is also where backup.sh writes by default. A relative path
# resolves against this directory, so the default ./backups is docker/backups/
# — INSIDE the checkout when you deploy from a git clone. Both writers drop a
# `.gitignore` containing `*` into the directory so git never lists or adds
# the dumps or the .env copy (which holds APP_KEY), but on a git-clone install
# point it outside the tree, e.g. BACKUP_DIR=/var/backups/lineledger, and keep
# a copy of the dumps on another machine — a backup beside the database is not
# a backup of the server.
# BACKUP_DIR=./backups
# BACKUP_KEEP_DAYS=14
# BACKUP_INTERVAL_SECONDS=86400

# --- Optional: MinIO object storage (docker compose --profile minio) ---
# Required when the minio profile is enabled — the container fails to start
# without them (there is deliberately no insecure default). Choose a strong,
# unique password. The console/API bind to loopback; reach them via the reverse
# proxy or an SSH tunnel, not the public interface.
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
