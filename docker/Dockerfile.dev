# syntax=docker/dockerfile:1
#
# Development image: PHP 8.5 + Composer + Node 22 + poppler, no app COPY.
# The compose file bind-mounts the repo at /app. Not used for the GHCR
# self-host image (see Dockerfile + docker/docker-compose.yml).

FROM node:22-bookworm-slim AS node

FROM dunglas/frankenphp:1-php8.5

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Copy Node/npm only — not all of /usr/local, which would clobber PHP.
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

RUN install-php-extensions pdo_mysql pdo_sqlite intl zip gd bcmath pcntl opcache

# poppler-utils: pdftotext for bank-statement PDF import
# git/unzip: composer packages
# curl: healthchecks
RUN apt-get update && apt-get install -y --no-install-recommends \
        poppler-utils \
        git \
        unzip \
        curl \
    && rm -rf /var/lib/apt/lists/*

RUN mv "$PHP_INI_DIR/php.ini-development" "$PHP_INI_DIR/php.ini"
COPY docker/php.dev.ini $PHP_INI_DIR/conf.d/99-lineledger-dev.ini

COPY docker/dev-entrypoint.sh /usr/local/bin/dev-entrypoint.sh
RUN chmod +x /usr/local/bin/dev-entrypoint.sh

# Writable caches for whatever uid compose runs as (DEV_UID).
ENV COMPOSER_HOME=/tmp/composer \
    NPM_CONFIG_CACHE=/tmp/npm \
    HOME=/tmp \
    XDG_CONFIG_HOME=/tmp \
    CONTAINER_ROLE=app

WORKDIR /app

EXPOSE 8000 5173

ENTRYPOINT ["dev-entrypoint.sh"]
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000"]
