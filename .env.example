APP_NAME=LineLedger
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Country this deployment serves (CA / US) for the guest country-switcher banner.
# Leave blank in production to derive it from the request host (books.lineledger.ca
# → CA, otherwise US); set it on host-agnostic environments like local dev.
APP_REGION=
APP_URL_CA=https://books.lineledger.ca
APP_URL_US=https://books.lineledger.com

# Marketing sites where the legal documents (terms, privacy, …) are published,
# picked by the region resolved above.
MARKETING_URL_CA=https://lineledger.ca
MARKETING_URL_US=https://lineledger.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Secret used to derive passkey (WebAuthn) user handles. Falls back to APP_KEY when
# the key is absent — which means a later APP_KEY rotation would invalidate every
# registered passkey. Set a stable, secret random string in production and never
# rotate it. Leave this line commented out rather than blank: an empty value is used
# as-is, it does NOT fall back to APP_KEY.
# PASSKEYS_USER_HANDLE_SECRET=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Error tracking (Laravel Nightwatch). The package is installed and instruments
# requests, commands, queries, and exceptions automatically — it only ships data
# once a token is set, so production observability is "add the token here". Leave
# unset locally; Nightwatch is inert without a token.
# NIGHTWATCH_TOKEN=
# NIGHTWATCH_ENABLED=true

# Ops alerting (scheduled monitors email this address on failure):
#   - security:monitor        — security-log anomalies (failed logins, lockouts, etc.)
#   - integrity:check         — ledger reconciliation failures
#   - audit:verify            — audit hash-chain failures (standalone runs)
#   - ops:monitor-failed-jobs — jobs that landed in the failed_jobs table
#   - every scheduled task    — a crash/non-zero exit, via OPS_ALERT_EMAIL
# All default to the FX health alert address when unset.
# SECURITY_ALERT_EMAIL=
# LEDGER_INTEGRITY_ALERT_EMAIL=
# OPS_ALERT_EMAIL=

# Content-Security-Policy delivery. 'report-only' (default) observes violations
# (logged to storage/logs/csp.log) without blocking; 'enforce' blocks — flip only
# after the report log is clean; 'off' sends no CSP header (for a self-host that
# customizes assets). With the Vite dev server running locally the policy allows
# it automatically, so 'off' is rarely needed in dev.
# CSP_MODE=report-only

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lineledger
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Session payloads are encrypted at rest and the cookie is marked Secure
# (HTTPS-only) automatically when APP_ENV=production — see config/session.php.
# Leave both unset locally so http://localhost keeps working; uncomment to
# force a value (e.g. to test HTTPS-only cookies against a local TLS proxy).
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Object storage. Only needed if you move uploads off the local disk (see the
# storage roles below). AWS_BUCKET is the private bucket (attachments, backups);
# AWS_PUBLIC_BUCKET is the public-read one holding company logos.
# AWS_ENDPOINT + AWS_USE_PATH_STYLE_ENDPOINT=true point these at an
# S3-compatible store instead (MinIO, Cloudflare R2, Backblaze B2).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ca-central-1
AWS_BUCKET=
AWS_URL=
AWS_PUBLIC_BUCKET=
AWS_PUBLIC_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Storage roles — which disk each kind of durable file lives on. Unset means the
# local filesystem, which is the right answer for a single-server install that
# backs up its storage/ directory. Set all three to move uploads to the buckets
# above; see "Object storage" in the README for the bucket + IAM policy.
# ATTACHMENT_DISK=s3
# LOGO_DISK=s3_public
# BACKUP_DISK=s3
#
# Livewire stages uploads here before they reach their permanent home. Leave it
# local: several importers read the staged file by filesystem path.
# LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

# Stripe Connect credentials: a company's own customers pay its invoices by
# card into the company's connected account. We never store a company's secret key.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_CLIENT_ID=
# Connect webhook (customer invoice payments) signing secret.
STRIPE_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"

# Cloudflare Turnstile — bot challenge on the public auth forms (register,
# login, forgot-password). OFF until both keys are set, so self-hosted installs
# and local development are never gated; mint a key pair per hostname at
# Cloudflare dashboard > Turnstile. TURNSTILE_ENABLED=false is a hard kill switch.
# The site key is public; only the secret is sensitive. PUBLIC_TURNSTILE_SITE_KEY
# is accepted as an alias for TURNSTILE_SITE_KEY (the deployed envs use that name).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# TURNSTILE_ENABLED=true

# Per-IP throttle on account creation. Fortify ships POST /register unthrottled;
# enforced in App\Actions\Fortify\CreateNewUser.
REGISTER_RATE_LIMIT=5
REGISTER_RATE_DECAY=10
