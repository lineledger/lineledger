<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Pin a plain-HTTP base URL so tests are deterministic regardless of a
             developer's local .env (which may set an https host). Matches CI /
             .env.example and keeps request-scheme-sensitive assertions (e.g. the
             HSTS "plain HTTP" header test) honest. -->
        <env name="APP_URL" value="http://localhost"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="lineledger_test"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Keep statement-import AI off in tests so they stay deterministic and
             offline; tests that exercise the AI layer bind a fake intelligence. -->
        <env name="BANK_IMPORT_AI_ENABLED" value="false"/>
        <env name="ANTHROPIC_API_KEY" value=""/>
        <!-- Turnstile off by default, pinned rather than merely unset: a developer
             whose .env holds real keys would otherwise have every auth-form test
             challenged locally while CI (no keys) ran unchallenged. TurnstileTest
             opts in per-test via config(), which bypasses env entirely. -->
        <env name="TURNSTILE_ENABLED" value="false"/>
    </php>
</phpunit>
